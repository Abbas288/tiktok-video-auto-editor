{$SITE_ADDRESS:localhost} {
    tls {
        ca https://ca.camp.lnu.se:9000/acme/acme/directory
        ca_root /etc/ssl/certs/LNU_FTK_Campus_Root_CA_2025.pem
    }

    encode gzip zstd

    handle_path /api/* {
        reverse_proxy compile-server:3030
    }

    handle {
        reverse_proxy web:80
    }
}